# Copy this file to .env and fill in the values. The bot reads .env relative to its
# working directory, so it must sit next to the repository root it is started from.

# ---------------------------------------------------------------------------
# Bot token
# ---------------------------------------------------------------------------
# The bot logs in with the key named by TOKEN_KEY. It defaults to TOKEN_TEST, so a
# local run uses the test bot unless you say otherwise. On a production server set:
#   TOKEN_KEY=TOKEN
TOKEN_KEY=TOKEN_TEST

TOKEN=your_production_bot_token_here
TOKEN_TEST=your_test_bot_token_here

# ---------------------------------------------------------------------------
# Database (MariaDB)
# ---------------------------------------------------------------------------
# These are optional. When a key is missing the bot falls back to the value in
# brackets, which is why an .env without any DB_ keys still connects to a local
# MariaDB as root. Set them explicitly in production - the fallback credentials
# are a development convenience, not something to run a live bot on.
DB_HOST=localhost          # [localhost]
DB_PORT=3306               # [3306]
DB_NAME=sloth              # [sloth]
DB_USER=sloth              # [root]
DB_PASSWORD=               # [admin]

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed for the OAuth flow, not for running the bot itself.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=
